<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" sizes="64x64" href="{{ 'grovera-favicon-64.png' | asset_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preload" href="{{ 'grovera-logo.png' | asset_url }}" as="image">
    {% if template.name == 'index' %}<link rel="preload" href="{{ 'grovera-hero.jpg' | asset_url }}" as="image" fetchpriority="high">{% endif %}
    <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% else %}<meta name="description" content="GROVERA — Smart Agricultural Solutions for a Sustainable Future">{% endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    <style>:root{--g-primary:{{ settings.color_primary }};--g-secondary:{{ settings.color_secondary }};--g-accent:{{ settings.color_accent }};--g-bg:{{ settings.color_background }};--g-ink:{{ settings.color_text }};--g-body-font:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }};--g-heading-font:{{ settings.type_heading_font.family }},{{ settings.type_heading_font.fallback_families }};}</style>
    {{ 'grovera.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');window.GROVERA={root:{{ routes.root_url | json }},currency:{{ cart.currency.iso_code | default: localization.country.currency.iso_code | json }},locale:{{ request.locale.iso_code | json }},freeShipping:{{ settings.free_shipping_threshold | times:100 | json }}};</script>
    <script src="{{ 'grovera.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }},"logo":{{ 'grovera-logo.png' | asset_url | prepend:'https:' | json }},"description":"Smart Agricultural Solutions for a Sustainable Future"}</script>
  </head>
  <body class="template-{{ template.name }}" data-currency="{{ cart.currency.iso_code | default: localization.country.currency.iso_code }}">
    <a class="g-skip" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% section 'grovera-header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'grovera-footer' %}

    <div class="g-search-overlay" data-search-overlay aria-hidden="true">
      <button class="g-overlay-close" type="button" data-search-close aria-label="Close">×</button>
      <div class="g-search-panel">
        <span class="g-kicker">GROVERA SEARCH</span>
        <h2>{% if request.locale.iso_code == 'ar' %}ابحث عن منتجك{% else %}Find what you need{% endif %}</h2>
        <form action="{{ routes.search_url }}" method="get" role="search" class="g-search-big" data-predictive-search-form>
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{% if request.locale.iso_code == 'ar' %}اكتب اسم المنتج...{% else %}Search products...{% endif %}" autocomplete="off" data-predictive-search-input>
          <input type="hidden" name="type" value="product"><button class="g-btn g-btn--primary" type="submit">{% if request.locale.iso_code == 'ar' %}بحث{% else %}Search{% endif %}</button>
        </form>
        <div class="g-predictive-results" data-predictive-results></div>
      </div>
    </div>

    <aside class="g-cart-drawer" data-cart-drawer aria-hidden="true">
      <div class="g-drawer-head"><div><span class="g-kicker">CART</span><h3>{% if request.locale.iso_code == 'ar' %}سلة التسوق{% else %}Your cart{% endif %}</h3></div><button type="button" data-cart-close aria-label="Close">×</button></div>
      <div class="g-shipping-progress" data-shipping-progress hidden><div><span data-shipping-message></span><b data-shipping-progress-bar></b></div></div>
      <div class="g-drawer-body" data-cart-items></div>
      <div class="g-drawer-foot"><div class="g-drawer-total"><span>{% if request.locale.iso_code == 'ar' %}الإجمالي{% else %}Subtotal{% endif %}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div><a class="g-btn g-btn--primary g-btn--full" href="{{ routes.cart_url }}">{% if request.locale.iso_code == 'ar' %}عرض السلة والدفع{% else %}View cart & checkout{% endif %}</a></div>
    </aside>

    <aside class="g-wishlist-drawer" data-wishlist-drawer aria-hidden="true">
      <div class="g-drawer-head"><div><span class="g-kicker">WISHLIST</span><h3>{% if request.locale.iso_code == 'ar' %}المفضلة{% else %}Wishlist{% endif %}</h3></div><button type="button" data-wishlist-close aria-label="Close">×</button></div>
      <div class="g-drawer-body" data-wishlist-items></div>
    </aside>
    <div class="g-backdrop" data-backdrop></div>
  </body>
</html>
