<section class="g-page-hero"><div class="g-container"><span class="g-kicker">CHECKOUT READY</span><h1>{% if request.locale.iso_code == 'ar' %}سلة التسوق{% else %}Shopping cart{% endif %}</h1></div></section>
<section class="g-section"><div class="g-container">{% if cart.item_count == 0 %}<div class="g-empty-state g-empty-large"><div class="g-empty-icon">{% render 'icon', name:'bag' %}</div><h2>{% if request.locale.iso_code == 'ar' %}سلتك لسه فاضية{% else %}Your cart is empty{% endif %}</h2><p>{% if request.locale.iso_code == 'ar' %}استكشف الأقسام وأضف المنتجات التي تحتاجها.{% else %}Browse the store and add what you need.{% endif %}</p><a class="g-btn g-btn--primary" href="{{ routes.all_products_collection_url }}">{% if request.locale.iso_code == 'ar' %}ابدأ التسوق{% else %}Start shopping{% endif %}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="g-cart-page"><div class="g-cart-items">{% for item in cart.items %}<div class="g-cart-row"><a href="{{ item.url }}" class="g-cart-image">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading:'lazy', alt:item.product.title }}{% endif %}</a><div class="g-cart-copy"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% unless item.variant.title == 'Default Title' %}<span>{{ item.variant.title }}</span>{% endunless %}<a class="g-remove" href="{{ item.url_to_remove }}">{% if request.locale.iso_code == 'ar' %}إزالة{% else %}Remove{% endif %}</a></div><input class="g-cart-qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><aside class="g-cart-summary"><span class="g-kicker">ORDER SUMMARY</span><h3>{% if request.locale.iso_code == 'ar' %}ملخص الطلب{% else %}Order summary{% endif %}</h3><div><span>{% if request.locale.iso_code == 'ar' %}الإجمالي{% else %}Subtotal{% endif %}</span><strong>{{ cart.total_price | money }}</strong></div><button class="g-btn g-btn--outline g-btn--full" name="update" type="submit">{% if request.locale.iso_code == 'ar' %}تحديث السلة{% else %}Update cart{% endif %}</button><button class="g-btn g-btn--primary g-btn--full" name="checkout" type="submit">{% if request.locale.iso_code == 'ar' %}إتمام الشراء{% else %}Checkout{% endif %}</button><small>{% if request.locale.iso_code == 'ar' %}يتم احتساب الشحن والضرائب في الخطوة التالية.{% else %}Shipping and taxes calculated at checkout.{% endif %}</small></aside></form>{% endif %}</div></section>
{% schema %}{"name":"GROVERA Cart","settings":[]}{% endschema %}
