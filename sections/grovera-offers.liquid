<section class="g-offers-hero"><div class="g-container"><span class="g-kicker">GROVERA OFFERS</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div></section><section class="g-section"><div class="g-container">{% if section.settings.collection != blank %}<div class="g-products-grid">{% for product in section.settings.collection.products limit:24 %}{% render 'product-card', product:product %}{% endfor %}</div>{% else %}<div class="g-empty-state"><h2>{% if request.locale.iso_code == 'ar' %}اربط قسم العروض من محرر القالب{% else %}Select an offers collection in the theme editor{% endif %}</h2></div>{% endif %}</div></section>
{% schema %}{"name":"GROVERA Offers","settings":[{"type":"text","id":"heading","label":"Heading","default":"عروض GROVERA"},{"type":"textarea","id":"text","label":"Text","default":"خصومات وباقات موسمية مختارة."},{"type":"collection","id":"collection","label":"Offers collection"}]}
{% endschema %}
