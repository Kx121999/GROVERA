<section class="g-section g-categories-section">
  <div class="g-container">
    <div class="g-section-head"><div><span class="g-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div>
    <div class="g-category-grid">
      {% for block in section.blocks %}
        {% assign fallback = 'cat-seeds.jpg' %}
        {% case forloop.index %}{% when 2 %}{% assign fallback = 'cat-fertilizers.jpg' %}{% when 3 %}{% assign fallback = 'cat-pesticides.jpg' %}{% when 4 %}{% assign fallback = 'cat-irrigation.jpg' %}{% when 5 %}{% assign fallback = 'cat-tools.jpg' %}{% when 6 %}{% assign fallback = 'cat-greenhouses.jpg' %}{% when 7 %}{% assign fallback = 'cat-fertilizers.jpg' %}{% when 8 %}{% assign fallback = 'cat-pesticides.jpg' %}{% endcase %}
        {% assign target = block.settings.collection.url | default: routes.collections_url %}
        <a class="g-category-card" href="{{ target }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths:'480,720,1000,1200', alt:block.settings.title }}{% elsif block.settings.collection.image != blank %}{{ block.settings.collection.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt:block.settings.title }}{% else %}<img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">{% endif %}
          <span class="g-category-overlay"></span>
          <div class="g-category-copy"><span>{{ block.settings.micro }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.subtitle }}</p><b>{% if request.locale.iso_code == 'ar' %}عرض القسم{% else %}Explore{% endif %} {% render 'icon', name: 'arrow' %}</b></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"GROVERA Categories","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CATEGORY"},{"type":"text","id":"heading","label":"Heading","default":"تسوق حسب القسم"},{"type":"textarea","id":"text","label":"Text","default":"أقسام منظمة تساعدك توصل للمنتج الذي تبحث عنه بسرعة."}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"micro","label":"Small label","default":"GROVERA"},{"type":"text","id":"title","label":"Title","default":"البذور"},{"type":"text","id":"subtitle","label":"Subtitle","default":"أصناف ومحاصيل متنوعة"}]}],"presets":[{"name":"GROVERA Categories","blocks":[{"type":"category","settings":{"title":"البذور","subtitle":"أصناف ومحاصيل متنوعة"}},{"type":"category","settings":{"title":"الأسمدة والمغذيات","subtitle":"حلول تغذية نباتية"}},{"type":"category","settings":{"title":"المبيدات والحماية","subtitle":"منتجات حماية المحاصيل"}},{"type":"category","settings":{"title":"أنظمة الري","subtitle":"إدارة مياه أكثر كفاءة"}},{"type":"category","settings":{"title":"الأدوات الزراعية","subtitle":"معدات وأدوات للاستخدام اليومي"}},{"type":"category","settings":{"title":"البيوت المحمية","subtitle":"مستلزمات وتجهيزات الزراعة المحمية"}},{"type":"category","settings":{"title":"العناصر والمغذيات الدقيقة","subtitle":"احتياجات تغذية دقيقة ومتخصصة"}},{"type":"category","settings":{"title":"مكافحة الآفات","subtitle":"حلول ومنتجات مكافحة متنوعة"}}]}]}
{% endschema %}
