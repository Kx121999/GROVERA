<section class="g-section g-newsletter"><div class="g-container g-newsletter-inner"><div><span class="g-kicker">STAY UPDATED</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{% form 'customer', class: 'g-news-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button class="g-btn g-btn--primary" type="submit">{{ section.settings.button }}</button>{% if form.posted_successfully? %}<p class="g-form-success">{% if request.locale.iso_code == 'ar' %}تم الاشتراك بنجاح{% else %}Thank you for subscribing{% endif %}</p>{% endif %}{% endform %}</div></section>
{% schema %}
{"name":"GROVERA Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"خليك قريب من جديد GROVERA"},{"type":"textarea","id":"text","label":"Text","default":"عروض، منتجات جديدة وتحديثات المتجر مباشرة على بريدك."},{"type":"text","id":"placeholder","label":"Placeholder","default":"البريد الإلكتروني"},{"type":"text","id":"button","label":"Button","default":"اشتراك"}],"presets":[{"name":"GROVERA Newsletter"}]}
{% endschema %}
