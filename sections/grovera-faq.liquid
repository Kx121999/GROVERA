<section class="g-page-hero"><div class="g-container"><span class="g-kicker">FAQ</span><h1>{{ section.settings.heading }}</h1></div></section><section class="g-section"><div class="g-container g-faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"GROVERA FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"الأسئلة الشائعة"}],"blocks":[{"type":"item","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"كيف يتم الشحن داخل الإمارات؟"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>تظهر خيارات الشحن المتاحة حسب عنوان العميل أثناء إتمام الطلب.</p>"}]}],"presets":[{"name":"GROVERA FAQ","blocks":[{"type":"item"},{"type":"item","settings":{"question":"كيف أتابع طلبي؟","answer":"<p>يمكنك متابعة حالة الطلب من حسابك أو من رابط التتبع عند توفره.</p>"}},{"type":"item","settings":{"question":"هل يمكن التواصل عبر واتساب؟","answer":"<p>نعم، زر واتساب متاح في المتجر ويمكن تخصيص الرقم من إعدادات القالب.</p>"}}]}]}
{% endschema %}
