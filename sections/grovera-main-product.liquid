<section class="g-main-product" data-product-root>
  <div class="g-container">
    <nav class="g-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{% if request.locale.iso_code == 'ar' %}الرئيسية{% else %}Home{% endif %}</a><span>/</span>{% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a><span>/</span>{% endif %}<b>{{ product.title }}</b></nav>
    <div class="g-product-layout">
      <div class="g-product-gallery" data-gallery>
        <div class="g-product-main-media" data-main-media>
          {% if product.featured_media %}{{ product.featured_media | image_url: width: 2000 | image_tag: loading:'eager', fetchpriority:'high', widths:'640,900,1200,1600,2000', sizes:'(max-width: 900px) 100vw, 54vw', alt:product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
          <button class="g-product-zoom" type="button" data-zoom-open aria-label="{% if request.locale.iso_code == 'ar' %}تكبير الصورة{% else %}Zoom image{% endif %}">+</button>
        </div>
        {% if product.media.size > 1 %}<div class="g-thumbs" role="list">{% for media in product.media %}<button type="button" data-thumb data-src="{{ media.preview_image | image_url: width: 2000 }}" {% if forloop.first %}class="is-active"{% endif %}>{{ media.preview_image | image_url: width: 180 | image_tag: loading:'lazy', alt:product.title }}</button>{% endfor %}</div>{% endif %}
      </div>
      <div class="g-product-detail">
        <div class="g-product-title-row">
          <div>{% if product.type != blank %}<span class="g-kicker">{{ product.type }}</span>{% endif %}<h1>{{ product.title }}</h1></div>
          <button class="g-wishlist-btn g-wishlist-btn--product" type="button" data-wishlist-toggle data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 }}{% endif %}">{% render 'icon', name:'heart' %}</button>
        </div>
        {% if product.vendor != blank and section.settings.show_vendor %}<p class="g-vendor">{{ product.vendor }}</p>{% endif %}
        <div class="g-product-price"><strong data-product-price>{{ product.selected_or_first_available_variant.price | money }}</strong>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s data-product-compare>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</div>
        <div class="g-stock-line {% unless product.selected_or_first_available_variant.available %}is-out{% endunless %}" data-stock-line>{% if product.selected_or_first_available_variant.available %}<span></span>{% if request.locale.iso_code == 'ar' %}متوفر وجاهز للطلب{% else %}In stock and ready to order{% endif %}{% else %}{% if request.locale.iso_code == 'ar' %}غير متوفر حالياً{% else %}Currently unavailable{% endif %}{% endif %}</div>
        {% if product.description != blank %}<div class="g-product-intro">{{ product.description | strip_html | truncatewords: 42 }}</div>{% endif %}
        {% form 'product', product, class:'g-product-form', data-product-form:'' %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <fieldset class="g-option-group"><legend>{{ option.name }}</legend><div class="g-option-values">{% for value in option.values %}<label><input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-radio><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
            {% endfor %}
          {% endunless %}
          <select name="id" data-variant-select class="g-visually-hidden" aria-hidden="true">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} data-price-cents="{{ variant.price }}" data-price="{{ variant.price | money }}" data-compare="{% if variant.compare_at_price %}{{ variant.compare_at_price | money }}{% endif %}" data-available="{{ variant.available }}" data-options="{{ variant.options | join:'||' | escape }}">{{ variant.title }}</option>{% endfor %}</select>
          <div class="g-qty-row"><label for="Quantity-{{ section.id }}">{% if request.locale.iso_code == 'ar' %}الكمية{% else %}Quantity{% endif %}</label><div class="g-qty"><button type="button" data-qty-minus aria-label="minus">−</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric"><button type="button" data-qty-plus aria-label="plus">+</button></div></div>
          <button class="g-btn g-btn--primary g-btn--full g-add-to-cart" type="submit" data-main-add {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{% if request.locale.iso_code == 'ar' %}أضف إلى السلة{% else %}Add to cart{% endif %}{% else %}{% if request.locale.iso_code == 'ar' %}غير متوفر{% else %}Sold out{% endif %}{% endif %}</button>
          {% if section.settings.show_dynamic_checkout %}<div class="g-dynamic-checkout">{{ form | payment_button }}</div>{% endif %}
        {% endform %}
        {% if settings.whatsapp_number != blank %}<a class="g-btn g-btn--whatsapp g-btn--full" target="_blank" rel="noopener" href="https://wa.me/{{ settings.whatsapp_number | remove:'+' | remove:' ' }}?text={{ product.title | append:' - ' | append:shop.url | append:product.url | url_encode }}">{% if request.locale.iso_code == 'ar' %}اسأل عن المنتج عبر واتساب{% else %}Ask about this product on WhatsApp{% endif %}</a>{% endif %}
        <div class="g-product-meta"><div>{% render 'icon', name:'truck' %}<span><strong>{% if request.locale.iso_code == 'ar' %}الشحن داخل الإمارات{% else %}UAE delivery{% endif %}</strong>{{ section.settings.shipping_text }}</span></div><div>{% render 'icon', name:'shield' %}<span><strong>{% if request.locale.iso_code == 'ar' %}دفع آمن{% else %}Secure checkout{% endif %}</strong>{{ section.settings.secure_text }}</span></div></div>
        <div class="g-accordions">
          {% if product.description != blank %}<details open><summary>{% if request.locale.iso_code == 'ar' %}وصف المنتج{% else %}Product description{% endif %}</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
          {% if product.metafields.custom.specifications != blank %}<details><summary>{% if request.locale.iso_code == 'ar' %}المواصفات{% else %}Specifications{% endif %}</summary><div class="rte">{{ product.metafields.custom.specifications | metafield_tag }}</div></details>{% endif %}
          <details><summary>{% if request.locale.iso_code == 'ar' %}الشحن والتوصيل{% else %}Shipping & delivery{% endif %}</summary><div class="rte"><p>{{ section.settings.shipping_details }}</p></div></details>
          <details><summary>{% if request.locale.iso_code == 'ar' %}الاسترجاع والاستبدال{% else %}Returns & exchanges{% endif %}</summary><div class="rte"><p>{{ section.settings.returns_text }}</p>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{% if request.locale.iso_code == 'ar' %}عرض السياسة كاملة{% else %}View full policy{% endif %}</a>{% endif %}</div></details>
        </div>
      </div>
    </div>
  </div>
  <div class="g-sticky-atc" data-sticky-atc>
    <div class="g-container"><div class="g-sticky-product">{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: loading:'lazy', alt:product.title }}{% endif %}<div><strong>{{ product.title }}</strong><span data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span></div></div><button class="g-btn g-btn--primary" type="button" data-sticky-add>{% if request.locale.iso_code == 'ar' %}أضف للسلة{% else %}Add to cart{% endif %}</button></div>
  </div>
  <script type="application/json" data-current-product>{"handle":{{ product.handle | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | json }}{% else %}""{% endif %},"price":{{ product.price | money | json }}}</script>
<script type="application/ld+json">{{ product | structured_data }}</script>
</section>
<div class="g-image-zoom" data-image-zoom aria-hidden="true"><button type="button" data-zoom-close>×</button><img src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 2400 }}{% endif %}" alt="{{ product.title | escape }}" data-zoom-image></div>
{% schema %}
{"name":"GROVERA Product","settings":[{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"checkbox","id":"show_dynamic_checkout","label":"Show Buy now button","default":true},{"type":"text","id":"shipping_text","label":"Shipping short text","default":"تظهر الخيارات ووقت التوصيل حسب الإمارة عند الدفع."},{"type":"text","id":"secure_text","label":"Secure text","default":"Checkout موثوق ومشفر عبر Shopify."},{"type":"textarea","id":"shipping_details","label":"Shipping details","default":"يتم احتساب خيارات الشحن ووقت التوصيل حسب عنوان العميل أثناء إتمام الطلب."},{"type":"textarea","id":"returns_text","label":"Returns text","default":"تخضع عمليات الاسترجاع والاستبدال لسياسة المتجر ونوع المنتج وحالته عند الاستلام."}]}
{% endschema %}
