<section class="g-collection-hero{% if collection.image %} has-image{% endif %}"{% if collection.image %} style="--collection-image:url('{{ collection.image | image_url: width: 1800 }}')"{% endif %}><div class="g-container"><span class="g-kicker">GROVERA COLLECTION</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="g-collection-desc">{{ collection.description }}</div>{% endif %}</div></section>
<section class="g-section g-collection-section"><div class="g-container">
  <div class="g-collection-mobile-tools"><button class="g-btn g-btn--outline" type="button" data-filter-open>{% if request.locale.iso_code == 'ar' %}تصفية المنتجات{% else %}Filters{% endif %}</button><span>{{ collection.products_count }} {% if request.locale.iso_code == 'ar' %}منتج{% else %}products{% endif %}</span></div>
  <div class="g-collection-layout">
    <aside class="g-filters" data-filter-drawer><div class="g-filter-head"><div class="g-filter-title">{% if request.locale.iso_code == 'ar' %}تصفية المنتجات{% else %}Filters{% endif %}</div><button type="button" data-filter-close>×</button></div>
      <form id="CollectionFiltersForm" data-filter-form>
        {% for filter in collection.filters %}<details open><summary>{{ filter.label }}</summary><div class="g-filter-values">{% case filter.type %}{% when 'list','boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label }} <small>({{ value.count }})</small></span></label>{% endfor %}{% when 'price_range' %}<div class="g-price-filter"><label><span>{% if request.locale.iso_code == 'ar' %}من{% else %}Min{% endif %}</span><input name="{{ filter.min_value.param_name }}" type="number" min="0" placeholder="0" value="{{ filter.min_value.value | money_without_currency | replace:',','' }}"></label><label><span>{% if request.locale.iso_code == 'ar' %}إلى{% else %}Max{% endif %}</span><input name="{{ filter.max_value.param_name }}" type="number" min="0" placeholder="{{ filter.range_max | money_without_currency | replace:',','' }}" value="{{ filter.max_value.value | money_without_currency | replace:',','' }}"></label></div>{% endcase %}</div></details>{% endfor %}
        <div class="g-filter-actions"><button class="g-btn g-btn--primary g-btn--full" type="submit">{% if request.locale.iso_code == 'ar' %}تطبيق الفلاتر{% else %}Apply filters{% endif %}</button><a class="g-text-link g-filter-clear" href="{{ collection.url }}">{% if request.locale.iso_code == 'ar' %}مسح الكل{% else %}Clear all{% endif %}</a></div>
      </form>
    </aside>
    <div class="g-collection-main">
      {% if collection.all_tags.size > 0 %}<div class="g-collection-tags">{% for tag in collection.all_tags limit:10 %}<a href="{{ collection.url }}/{{ tag | handle }}">{{ tag }}</a>{% endfor %}</div>{% endif %}
      <div class="g-collection-toolbar"><span>{{ collection.products_count }} {% if request.locale.iso_code == 'ar' %}منتج{% else %}products{% endif %}</span><form><label class="g-sort-label">{% if request.locale.iso_code == 'ar' %}ترتيب{% else %}Sort{% endif %}<select name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label></form></div>
      {% paginate collection.products by 24 %}<div class="g-products-grid">{% for product in collection.products %}{% render 'product-card', product:product %}{% else %}<div class="g-empty-state g-empty-large"><h3>{% if request.locale.iso_code == 'ar' %}لا توجد منتجات مطابقة{% else %}No matching products{% endif %}</h3><p>{% if request.locale.iso_code == 'ar' %}جرّب إزالة بعض الفلاتر أو تصفح قسم آخر.{% else %}Try clearing filters or exploring another collection.{% endif %}</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="g-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}
    </div>
  </div>
</div></section>
{% schema %}{"name":"GROVERA Collection","settings":[]}{% endschema %}
