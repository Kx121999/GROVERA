<section class="g-section g-section--tight"><div class="g-container"><div class="g-promo"><div class="g-promo-art"></div><div class="g-promo-copy"><span class="g-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{% if section.settings.button_label != blank %}<a class="g-btn g-btn--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name:'arrow' %}</a>{% endif %}</div></div></div></section>
{% schema %}
{"name":"GROVERA Promo","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SEASONAL OFFERS"},{"type":"text","id":"heading","label":"Heading","default":"عروض موسمية تستحق الاكتشاف"},{"type":"textarea","id":"text","label":"Text","default":"اكتشف الباقات والخصومات المختارة على احتياجات الزراعة."},{"type":"text","id":"button_label","label":"Button","default":"شاهد العروض"},{"type":"url","id":"button_link","label":"Link"}],"presets":[{"name":"GROVERA Promo"}]}
{% endschema %}
