<section class="g-about-hero"><div class="g-container g-about-grid"><div><span class="g-kicker">ABOUT GROVERA</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div><div class="g-about-visual"><img src="{{ 'grovera-hero.jpg' | asset_url }}" alt="GROVERA"></div></div></section><section class="g-section"><div class="g-container g-about-values"><div><span>01</span><h3>{{ section.settings.v1 }}</h3><p>{{ section.settings.v1d }}</p></div><div><span>02</span><h3>{{ section.settings.v2 }}</h3><p>{{ section.settings.v2d }}</p></div><div><span>03</span><h3>{{ section.settings.v3 }}</h3><p>{{ section.settings.v3d }}</p></div></div></section>
{% schema %}
{"name":"GROVERA About","settings":[{"type":"text","id":"heading","label":"Heading","default":"حلول زراعية ذكية لمستقبل مستدام"},{"type":"textarea","id":"text","label":"Text","default":"GROVERA علامة متخصصة في توفير المنتجات والمستلزمات والحلول الزراعية ضمن تجربة حديثة تجمع الوضوح والجودة وسهولة الوصول."},{"type":"text","id":"v1","label":"Value 1","default":"اختيار أوضح"},{"type":"textarea","id":"v1d","label":"Description","default":"تنظيم المنتجات والأقسام بطريقة تساعد العميل على الوصول لما يحتاجه بسرعة."},{"type":"text","id":"v2","label":"Value 2","default":"تجربة حديثة"},{"type":"textarea","id":"v2d","label":"Description","default":"متجر سريع ومتجاوب ومصمم للموبايل قبل أي شيء."},{"type":"text","id":"v3","label":"Value 3","default":"نمو مستدام"},{"type":"textarea","id":"v3d","label":"Description","default":"هوية زراعية حديثة تدعم التوسع في المنتجات والخدمات والأسواق."}]}
{% endschema %}
