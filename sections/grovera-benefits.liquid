<section class="g-section g-benefits-section"><div class="g-container"><div class="g-benefits"><div>{% render 'icon', name:'truck' %}<strong>{{ section.settings.t1 }}</strong><span>{{ section.settings.d1 }}</span></div><div>{% render 'icon', name:'shield' %}<strong>{{ section.settings.t2 }}</strong><span>{{ section.settings.d2 }}</span></div><div>{% render 'icon', name:'support' %}<strong>{{ section.settings.t3 }}</strong><span>{{ section.settings.d3 }}</span></div><div>{% render 'icon', name:'leaf' %}<strong>{{ section.settings.t4 }}</strong><span>{{ section.settings.d4 }}</span></div></div></div></section>
{% schema %}
{"name":"GROVERA Benefits","settings":[{"type":"text","id":"t1","label":"Title 1","default":"توصيل داخل الإمارات"},{"type":"text","id":"d1","label":"Description 1","default":"خيارات شحن واضحة حسب الإمارة"},{"type":"text","id":"t2","label":"Title 2","default":"دفع آمن"},{"type":"text","id":"d2","label":"Description 2","default":"Checkout موثوق من Shopify"},{"type":"text","id":"t3","label":"Title 3","default":"دعم مباشر"},{"type":"text","id":"d3","label":"Description 3","default":"تواصل سريع عند الحاجة"},{"type":"text","id":"t4","label":"Title 4","default":"متجر متخصص"},{"type":"text","id":"d4","label":"Description 4","default":"تجربة مصممة للمجال الزراعي"}],"presets":[{"name":"GROVERA Benefits"}]}
{% endschema %}
