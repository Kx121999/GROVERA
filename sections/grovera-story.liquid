<section class="g-section">
  <div class="g-container g-story-grid">
    <div class="g-story-photo"><img src="{{ 'cat-greenhouses.jpg' | asset_url }}" alt="GROVERA agriculture"><div class="g-story-badge"><span>GROVERA</span><strong>{{ section.settings.badge }}</strong></div></div>
    <div class="g-story-copy"><span class="g-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><div class="g-story-stats"><div><strong>{{ section.settings.stat_1 }}</strong><span>{{ section.settings.stat_1_label }}</span></div><div><strong>{{ section.settings.stat_2 }}</strong><span>{{ section.settings.stat_2_label }}</span></div><div><strong>{{ section.settings.stat_3 }}</strong><span>{{ section.settings.stat_3_label }}</span></div></div>{% if section.settings.button_label != blank %}<a class="g-btn g-btn--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div>
  </div>
</section>
{% schema %}
{"name":"GROVERA Story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SMART AGRICULTURE"},{"type":"text","id":"heading","label":"Heading","default":"أكثر من متجر زراعي"},{"type":"textarea","id":"text","label":"Text","default":"GROVERA تجمع احتياجات الزراعة في تجربة واحدة حديثة: منتجات منظمة، شراء سريع، دعم واضح وهوية تعكس مستقبل الزراعة."},{"type":"text","id":"badge","label":"Image badge","default":"حلول تنمو معك"},{"type":"text","id":"stat_1","label":"Stat 1","default":"6+"},{"type":"text","id":"stat_1_label","label":"Stat 1 label","default":"أقسام رئيسية"},{"type":"text","id":"stat_2","label":"Stat 2","default":"UAE"},{"type":"text","id":"stat_2_label","label":"توصيل داخل الإمارات"},{"type":"text","id":"stat_3","label":"Stat 3","default":"24/7"},{"type":"text","id":"stat_3_label","label":"الطلب متاح أونلاين"},{"type":"text","id":"button_label","label":"Button","default":"تعرف على GROVERA"},{"type":"url","id":"button_link","label":"Link"}],"presets":[{"name":"GROVERA Story"}]}
{% endschema %}
