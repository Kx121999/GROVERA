<section class="g-brand-strip">
  <div class="g-container">
    <div class="g-brand-strip-head"><span class="g-kicker">{{ section.settings.eyebrow }}</span><p>{{ section.settings.text }}</p></div>
    <div class="g-brand-marquee" aria-label="{{ section.settings.heading }}">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="g-brand-chip" {{ block.shopify_attributes }}>{% else %}<div class="g-brand-chip" {{ block.shopify_attributes }}>{% endif %}
          {% if block.settings.logo != blank %}{{ block.settings.logo | image_url: width: 320 | image_tag: loading:'lazy', alt:block.settings.name }}{% else %}<span>{{ block.settings.name }}</span>{% endif %}
        {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"GROVERA Brands","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BRANDS & PARTNERS"},{"type":"text","id":"heading","label":"Heading","default":"العلامات المتوفرة"},{"type":"text","id":"text","label":"Text","default":"يمكنك ربط شعارات العلامات المتوفرة من محرر القالب."}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Name","default":"GROVERA"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"GROVERA Brands","blocks":[{"type":"brand","settings":{"name":"SEEDS"}},{"type":"brand","settings":{"name":"FERTILIZERS"}},{"type":"brand","settings":{"name":"IRRIGATION"}},{"type":"brand","settings":{"name":"TOOLS"}},{"type":"brand","settings":{"name":"CROP CARE"}}]}]}
{% endschema %}
