<section class="g-page-hero"><div class="g-container"><span class="g-kicker">CONTACT GROVERA</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div></section><section class="g-section"><div class="g-container g-contact-grid"><div class="g-contact-info"><h2>{% if request.locale.iso_code == 'ar' %}تواصل معنا{% else %}Get in touch{% endif %}</h2><p>{{ section.settings.side_text }}</p>{% if settings.whatsapp_number != blank %}<a class="g-contact-line" href="https://wa.me/{{ settings.whatsapp_number | remove:'+' | remove:' ' }}"><strong>WhatsApp</strong><span>{{ settings.whatsapp_label }}</span></a>{% endif %}{% if shop.email != blank %}<a class="g-contact-line" href="mailto:{{ shop.email }}"><strong>Email</strong><span>{{ shop.email }}</span></a>{% endif %}</div>{% form 'contact', class:'g-contact-form' %}{% if form.posted_successfully? %}<div class="g-form-success">{% if request.locale.iso_code == 'ar' %}وصلتنا رسالتك بنجاح.{% else %}Your message has been sent.{% endif %}</div>{% endif %}{{ form.errors | default_errors }}<label>{% if request.locale.iso_code == 'ar' %}الاسم{% else %}Name{% endif %}<input type="text" name="contact[name]" required></label><label>{% if request.locale.iso_code == 'ar' %}البريد الإلكتروني{% else %}Email{% endif %}<input type="email" name="contact[email]" required></label><label>{% if request.locale.iso_code == 'ar' %}رقم الهاتف{% else %}Phone{% endif %}<input type="tel" name="contact[phone]"></label><label>{% if request.locale.iso_code == 'ar' %}الرسالة{% else %}Message{% endif %}<textarea name="contact[body]" rows="7" required></textarea></label><button class="g-btn g-btn--primary" type="submit">{% if request.locale.iso_code == 'ar' %}إرسال الرسالة{% else %}Send message{% endif %}</button>{% endform %}</div></section>
{% schema %}{"name":"GROVERA Contact","settings":[{"type":"text","id":"heading","label":"Heading","default":"نحن هنا لمساعدتك"},{"type":"textarea","id":"text","label":"Intro","default":"تواصل مع فريق GROVERA لأي استفسار متعلق بالمتجر أو الطلبات."},{"type":"textarea","id":"side_text","label":"Side text","default":"اختر وسيلة التواصل المناسبة وسنرد عليك في أقرب وقت ممكن."}]}
{% endschema %}
