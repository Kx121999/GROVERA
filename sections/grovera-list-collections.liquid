<section class="g-page-hero"><div class="g-container"><span class="g-kicker">SHOP GROVERA</span><h1>{% if request.locale.iso_code == 'ar' %}كل الأقسام{% else %}All collections{% endif %}</h1><p>{% if request.locale.iso_code == 'ar' %}استكشف جميع أقسام GROVERA واختر الفئة المناسبة لك.{% else %}Explore all GROVERA collections and find what you need.{% endif %}</p></div></section>
<section class="g-section"><div class="g-container"><div class="g-list-collections-grid">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="g-list-collection-card" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 1000 | image_tag: loading:'lazy', widths:'400,700,1000', alt:collection.title }}{% elsif collection.products.first.featured_image %}{{ collection.products.first.featured_image | image_url: width: 1000 | image_tag: loading:'lazy', alt:collection.title }}{% else %}<div class="g-collection-placeholder">{% render 'icon', name:'leaf' %}</div>{% endif %}<div><span>{{ collection.products_count }} {% if request.locale.iso_code == 'ar' %}منتج{% else %}products{% endif %}</span><h2>{{ collection.title }}</h2>{% if collection.description != blank %}<p>{{ collection.description | strip_html | truncatewords: 18 }}</p>{% endif %}<b>{% if request.locale.iso_code == 'ar' %}عرض القسم{% else %}Explore collection{% endif %} {% render 'icon', name:'arrow' %}</b></div></a>{% endunless %}{% else %}<div class="g-empty-state g-empty-large"><h2>{% if request.locale.iso_code == 'ar' %}أضف الأقسام من Shopify Admin{% else %}Add collections in Shopify Admin{% endif %}</h2></div>{% endfor %}</div></div></section>
{% schema %}{"name":"GROVERA Collections List","settings":[]}{% endschema %}
