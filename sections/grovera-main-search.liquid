<section class="g-page-hero"><div class="g-container"><span class="g-kicker">SEARCH</span><h1>{% if request.locale.iso_code == 'ar' %}البحث في GROVERA{% else %}Search GROVERA{% endif %}</h1><form action="{{ routes.search_url }}" method="get" class="g-search-big g-search-page-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{% if request.locale.iso_code == 'ar' %}ابحث عن منتج...{% else %}Search products...{% endif %}"><input type="hidden" name="type" value="product"><button class="g-btn g-btn--primary" type="submit">{% if request.locale.iso_code == 'ar' %}بحث{% else %}Search{% endif %}</button></form></div></section>
{% if search.performed %}<section class="g-section"><div class="g-container"><div class="g-section-head"><h2>{% if request.locale.iso_code == 'ar' %}نتائج البحث عن “{{ search.terms }}”{% else %}Results for “{{ search.terms }}”{% endif %}</h2><span>{{ search.results_count }}</span></div>{% paginate search.results by 24 %}<div class="g-products-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product:item %}{% endif %}{% else %}<div class="g-empty-state"><h3>{% if request.locale.iso_code == 'ar' %}لم نجد منتجات مطابقة{% else %}No matching products{% endif %}</h3></div>{% endfor %}</div>{% if paginate.pages>1 %}<nav class="g-pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></section>{% endif %}
{% schema %}{"name":"GROVERA Search","settings":[]}{% endschema %}
